{
  "name": "@cordlab/ui",
  "version": "0.1.1",
  "description": "Reusable React UI components for CordLab projects",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/cordlab-ui.cjs",
  "module": "./dist/cordlab-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/cordlab-ui.js",
      "require": "./dist/cordlab-ui.cjs"
    },
    "./styles.css": "./dist/cordlab-ui.css"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.build.json && vite build",
    "dev": "vite",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CordLabTechnologies/ui.git"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "component-library",
    "cordlab"
  ],
  "author": "CordLab Technologies",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CordLabTechnologies/ui/issues"
  },
  "homepage": "https://github.com/CordLabTechnologies/ui#readme",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
